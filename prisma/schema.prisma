generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Papel garagem_public (visitantes), sujeito a RLS. O admin usa ADMIN_DATABASE_URL (lib/db.ts).
  // O CLI (db push) usa o papel dono via directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  description   String           @default("")
  price         Float
  originalPrice Float?
  /// Link do produto novo (referência de preço). Só https, validado no servidor.
  referenceUrl  String?
  condition     String           @default("Bom estado")
  // "disponivel" | "reservado" | "vendido"
  status        String           @default("disponivel")
  acceptsOffers Boolean          @default(false)
  featured      Boolean          @default(false)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos        ItemPhoto[]
  messages      ContactMessage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([categoryId])
}

model ItemPhoto {
  id                 String   @id @default(cuid())
  itemId             String
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url                String?
  cloud_storage_path String?
  thumbnailPath      String?
  isPublic           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([itemId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

model SiteSettings {
  id                 String    @id @default("main")
  siteTitle          String    @default("Garagem do Fabio")
  heroTitle          String    @default("Tudo precisa ir!")
  heroSubtitle       String    @default("")
  whatsapp           String    @default("")
  saleEndDate        DateTime?
  pickupCity         String    @default("")
  pickupNeighborhood String    @default("")
  pickupInfo         String    @default("")
  paymentInfo        String    @default("")
  announcement       String    @default("")
  showCountdown      Boolean   @default(true)
  showStats          Boolean   @default(true)
  /// Textos editáveis do site (chaves em lib/site-texts.ts); vazio = texto padrão
  texts              Json      @default("{}")
  updatedAt          DateTime  @updatedAt
}

/// Contador de tentativas (login, contato, admin). Acessado só pela função rate_limit_hit (SECURITY DEFINER).
model RateLimit {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)
}
