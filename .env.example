# Banco PostgreSQL — dois papéis (ver scripts/db-security.ts):
#  DATABASE_URL          → garagem_public (visitantes; só lê catálogo e insere mensagens)
#  ADMIN_DATABASE_URL    → garagem_admin (só usado depois de validar a sessão do admin)
#  MIGRATE_DATABASE_URL  → papel dono (só no deploy: db push, tranca e seed; removido do processo do site)
#  APP_DB_PASSWORD_*     → senhas dos dois papéis, DIFERENTES (32+ letras/números: openssl rand -hex 24)
DATABASE_URL="postgresql://garagem_public:SENHA_PUBLIC@host:5432/garagem"
ADMIN_DATABASE_URL="postgresql://garagem_admin:SENHA_ADMIN@host:5432/garagem"
MIGRATE_DATABASE_URL="postgresql://dono:senha@host:5432/garagem"
APP_DB_PASSWORD_PUBLIC=""
APP_DB_PASSWORD_ADMIN=""

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET=""

# Admin criado pelo seed (não existe cadastro público)
SEED_ADMIN_EMAIL="admin@exemplo.com"
# Produção: só o hash (gere com `npm run admin:hash`). Desenvolvimento: pode usar SEED_ADMIN_PASSWORD (só cria, nunca sobrescreve).
ADMIN_PASSWORD_HASH=""
SEED_ADMIN_PASSWORD=""

# URL pública do site (usada no link do WhatsApp e nas tags OG)
NEXT_PUBLIC_SITE_URL="https://garagem.fabiocosta.me"

# Armazenamento de fotos (AWS S3 ou Cloudflare R2).
# Se S3_BUCKET ficar vazio, as fotos são salvas localmente em .uploads/ (só para desenvolvimento).
S3_BUCKET=""
S3_REGION="us-east-1"            # R2: "auto"
S3_ENDPOINT=""                   # R2: https://<account-id>.r2.cloudflarestorage.com  (S3: deixe vazio)
NEXT_PUBLIC_S3_PUBLIC_URL=""                 # URL pública do bucket, ex: https://pub-xxxx.r2.dev ou https://<bucket>.s3.amazonaws.com
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Google Analytics 4 (opcional — sem valor, o script não carrega)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Cria 12 itens de exemplo num banco vazio (só em desenvolvimento)
SEED_SAMPLE_ITEMS="false"

# Aviso por e-mail de mensagem nova (Resend). Sem estas três, o aviso fica desligado.
# Chave com permissão "Sending access" restrita ao domínio. Remetente precisa ser do domínio verificado.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
